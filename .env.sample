# --- メール送信まで行う場合の最低限の例（新規 .env の目安）---
GOOGLE_API_KEY="あなたのAPIキー"
TRUTH_ASSESSMENT_GROUNDING=1
TO_EMAIL="あなたのメルアド"
GMAIL_USER="送信元のメルアド"
GMAIL_APP_PASSWORD="送信元のGmailのアプリパスワード"
# アプリパスワード(16文字)。通常ログインパスワードではない
# 注意: Google の発行画面からそのままコピペすると、見た目はスペースでも「ノンブレークスペース(U+00A0)」が
# 混ざることがあり、メール送信でエラーになることがあります。手入力するか、メモ帳等に貼って通常の
# 半角スペースに直す／スペース無し16文字にしてから .env に書いてください。
# https://myaccount.google.com/apppasswords
# 2段階認証が有効なアカウントなら、ここで「アプリ パスワード」のページが開きます。
# 宛先は MAIL_TO でも可。メール不要なら TO_EMAIL/MAIL_TO を空にして run_pipeline.sh → 自動 --skip-email

# Google Gemini API キー
# 単一: GOOGLE_API_KEY のみ
# 複数: GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, …（数字は m03_api_key_manager が走査）
# キー本数分ローテーションするとレート制限回避に有効
GOOGLE_API_KEY=""
# GOOGLE_API_KEY_1=""
# GOOGLE_API_KEY_2=""
# GOOGLE_API_KEY_3=""
# 必要に応じて GOOGLE_API_KEY_4 … なども可（a03 の直参照フォールバックは _6 まで）


# モデル列: 要約は m03_gemini_model_fallback.get_gemini_model_fallback_chain(for_summary=True) があればそれを使用、なければ a03 内の既定（gemini-3.1-flash-lite → 3-flash-preview → 2.5-flash → 2.5-flash-lite）。
# 真実度は既定で gemini-2.5-flash, gemini-2.5-flash-lite のみ（要約列と別）。上書き例:
# GEMINI_TRUTH_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# 要約プロンプト（a02）。未設定時は financial（投資・年金・税制等向け章立て）
# SUMMARY_PROMPT_MODE=financial

# 真実度: 要約本文 + Google 検索（軽量）。失敗しても要約は保存される。
TRUTH_ASSESSMENT_GROUNDING=1
# 検索+真実度失敗時に JSON のみ等へ落とさない（0=オフ推奨）
TRUTH_FALLBACK_ON_SEARCH_FAIL=0
# 真実度モデル列（カンマ区切り）。先頭から GEMINI_TRUTH_MAX_MODELS 個まで
# GEMINI_TRUTH_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TRUTH_MAX_MODELS=2
# モデルあたりの追加リトライ回数（1=初回+1回リトライ）
GEMINI_TRUTH_MAX_RETRIES=1
# 真実度: 同一モデル内リトライ前の待機秒（別プロジェクトのキー切替後も適用）
GEMINI_TRUTH_RETRY_DELAY_SEC=60
# 要約成功後、真実度開始前の待機秒（別プロジェクトなら 0 でも可）
TRUTH_DELAY_AFTER_SUMMARY_SEC=30
# チャンネル連続処理: 1件完了後→次件開始前の待機秒（既定 61）
# 成果物は output/<スラッグ>_<公開日YYYYMMDD>_<videoid>/ 。取得済み videoid はスキップ。
# CHANNEL_PIPELINE_GAP_SEC=5
# 真実度: リトライ・モデル切替のたびに次キーへ（1=有効・既定）
TRUTH_ALWAYS_ROTATE_KEY=1
# Google Search グラウンディング最小テスト（test_grounding_search.py）の既定モデル
# TEST_GROUNDING_MODEL=gemini-2.5-flash-lite
# 真実度: 入力トークン推定・エラー診断・usage ログ（1=有効・既定）
TRUTH_VERBOSE_REQUEST_LOG=1
# TRUTH_ALWAYS_ROTATE_KEY=0 のときのみ有効（キー切替上限）
GEMINI_TRUTH_MAX_KEY_ROTATIONS=0
# 404（new users 等）で同一モデルのキーを回す上限（0=ロード済み全キー）
# TRUTH_MAX_PROJECT_RESTRICTED_KEY_SKIPS=10
GEMINI_TRUTH_JSON_PARSE_RETRIES=1

# 要約 API: 同一モデル内の最大試行回数（429 等）
# GEMINI_MAX_API_RETRIES=5

# 送信先（いずれか。run_pipeline.sh は MAIL_TO / TO_EMAIL の有無で --skip-email を切り替え）
# MAIL_TO=""
TO_EMAIL=""

# Gmail SMTP（a04。未設定ならメール送信スキップ）
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# 上記は「アプリ パスワード」（16文字）。通常の Gmail ログインパスワードではない。
# コピペ時に U+00A0 が混ざることがあるので、手入力またはプレーンテキストで正規化してから貼ること。
# ブラウザのアドレスバーに次のURLを入力して開きます。
# https://myaccount.google.com/apppasswords
# 2段階認証が有効なアカウントなら、ここで「アプリ パスワード」のページが開きます。
# 開いたら「アプリを選択」で「メール」などを選び、「生成」で16文字のパスワードを発行できます。

# --- Cloud Shell のみ（任意）: YouTube 字幕が IP ブロック系で失敗したとき、ログに手動 Restart の案内を出す（sudo reboot は不可） ---
# CLOUDSHELL_REBOOT_ON_YOUTUBE_IP_BLOCK=1

# a04: 要約 API 失敗時に summary.txt に入れる文面（未設定はコード内の既定文）
# SUMMARY_UNAVAILABLE_BODY="【要約の自動生成は行えませんでした】\n..."

# a04: メール本文（要約）の最大文字数。正の整数のとき超過分を省略
# MAIL_BODY_SUMMARY_MAX_CHARS=8000

# パイプライン完了後に docs/index.html と docs/contents/<video_id>.html を生成（1 / true / yes / on）
# GitHub Pages: Settings → Pages → Branch main / Folder /docs
# run_pipeline.sh … 各動画完了後に docs/ を再生成
# run_pipeline_urls.sh … 全 URL のキュー完了後に docs/ を1回だけ生成
# BUILD_HTML_SITE=1
